import evaluate
import numpy as np
from transformers import AutoModelForSequenceClassification, AutoTokenizer, DataCollatorWithPadding, DebertaV2Config, DebertaV2Tokenizer, Trainer, TrainingArguments
import torch.nn as nn
import torch
import torch.nn.functional as F
from datasets import concatenate_datasets,Dataset
from transformers import set_seed

set_seed(42)
teacher= AutoModelForSequenceClassification.from_pretrained(
    r"D:\liu\Desktop\知识蒸馏\w3"
)
student=AutoModelForSequenceClassification.from_pretrained(
    "huawei-noah/TinyBERT_General_6L_768D",
    num_labels=2
)
print("fffffffffffffffff")
class DistillationTrainer(Trainer):
    def __init__(self,*args,teacher_model=None,**kwargs):
        super().__init__(*args,**kwargs)
        self.teacher=teacher_model
        self.teacher.requires_grad_(False)
        self._move_model_to_device(self.teacher,self.model.device)
        self.teacher.eval()
    def compute_loss(self,model,inputs,return_outputs=False,num_items_in_batch=None):
        sentences = inputs.pop("sentence")
        outputs_student=model(**inputs)
        student_loss=outputs_student.loss
        if not model.training:
            return (
            (student_loss, outputs_student)
            if return_outputs
            else student_loss
        )

        with torch.no_grad():
            mm=tokenizer_teacher(sentences, truncation=True,max_length=256,padding=True,return_tensors="pt").to(self.teacher.device)
            outputs_teacher=self.teacher(**mm)
        fun=nn.KLDivLoss(reduction="batchmean")
        logit=(fun(F.log_softmax(outputs_student.logits.float()/self.args.temperature,dim=-1),F.softmax(outputs_teacher.logits.float()/self.args.temperature,dim=-1))*self.args.temperature**2)
        loss=student_loss*self.args.alpha+logit*(1-self.args.alpha)
        return (loss,outputs_student) if return_outputs else loss
class DistillationArguments(TrainingArguments):
    def __init__(self,*args,alpha=0.5,temperature=2.0,**kwargs):
        super().__init__(*args,**kwargs)
        self.alpha=alpha
        self.temperature=temperature
training_args=DistillationArguments(
    output_dir=r"D:\liu\Desktop\知识蒸馏\student_output",
    num_train_epochs=5,
    per_device_train_batch_size=32,
    per_device_eval_batch_size=64,
    warmup_ratio=0.05,
    weight_decay=0.02,
    logging_steps=50,
    learning_rate=5e-5,
    eval_strategy="epoch",
    save_strategy="no",
    alpha=0.2,
    temperature=4.0,
    remove_unused_columns=False,
    bf16=True,
)
train_dataset = Dataset.from_file(
    r"D:\liu\Desktop\知识蒸馏\glue-train.arrow"
)
val_dataset=Dataset.from_file(
    r"D:\liu\Desktop\知识蒸馏\glue-validation.arrow"
)
tokenizer_teacher = DebertaV2Tokenizer(
    vocab_file=r"D:\hf_models\deberta_v3_base\spm.model"
)
class DistillationCollator:
    def __init__(self, tokenizer):
        self.tokenizer = tokenizer
    def __call__(self, features):
        sentences = [
            f["sentence"]
            for f in features
        ]

        student_features = [
            {
                "input_ids": f["input_ids"],
                "attention_mask": f["attention_mask"],
                "labels": f["label"],
            }
            for f in features
        ]

        batch = self.tokenizer.pad(
            student_features,
            padding=True,
            return_tensors="pt"
        )

        batch["sentence"] = sentences

        return batch
tokenizer_student = AutoTokenizer.from_pretrained("bert-base-uncased")
def preprocess_function(examples):
    return tokenizer_student(examples['sentence'], truncation=True,max_length=256)
tokenized_train = train_dataset.map(preprocess_function, batched=True)
tokenized_val = val_dataset.map(preprocess_function, batched=True)
neg = tokenized_train.filter(lambda x: x["label"] == 0)
pos = tokenized_train.filter(lambda x: x["label"] == 1)
    
    # 各随机取 512 个
neg = neg.shuffle(seed=42).select(range(4024))
pos = pos.shuffle(seed=42).select(range(4024))
    
    # 合并
train_1024 = concatenate_datasets([neg, pos])
train_1024=train_1024.shuffle(seed=43)
data_collator = DistillationCollator(tokenizer=tokenizer_student)
metric = evaluate.load("accuracy")


def compute_metrics(eval_pred):
    logits, labels = eval_pred
    predictions = np.argmax(logits, axis=-1)
    return metric.compute(predictions=predictions, references=labels)
trainer=DistillationTrainer(
    model=student,
    args=training_args,
    teacher_model=teacher,
    train_dataset=train_1024,
    eval_dataset=tokenized_val,
    processing_class=tokenizer_student,
    data_collator=data_collator,
    compute_metrics=compute_metrics,
)
trainer.train()


        
        
        



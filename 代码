    # --- 3. PEFT (LoRA) 设置 ---
    logger.info("Setting up PEFT...")
    model = FastLanguageModel.get_peft_model(
        model,
        r=16,
        lora_alpha=32,
        lora_dropout=0,
        bias="none",
        random_state=3407,
        use_gradient_checkpointing="unsloth",
        target_modules=[
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj",
],
    )
    print("ddddddddddddddddddddddddddddddddd")
    logger.info("Model parameters:" + str(sum(p.numel() for p in model.parameters())))

    # --- 4. 格式化数据集 ---
    logger.info("Formatting datasets...")
    train_dataset = train_dataset.map(formatting_prompts_func, batched=True, )
    neg = train_dataset.filter(lambda x: x["label"] == 0)
    pos = train_dataset.filter(lambda x: x["label"] == 1)

# 各随机取 512 个
    neg = neg.shuffle(seed=42).select(range(1024))
    pos = pos.shuffle(seed=42).select(range(1024))

# 合并
    train_1024 = concatenate_datasets([neg, pos])
    train_1024=train_1024.shuffle(seed=43)
    print(train_dataset[0])
    # --- 5. 训练参数 ---
    logger.info("Setting up Training Arguments...")
    training_args = TrainingArguments(
        output_dir="outputs_qwen",

        weight_decay=0.01,
        lr_scheduler_type="linear",
        seed=3407,
        save_strategy="no",
    )

    # --- 6. 初始化 SFTTrainer ---
    logger.info("Initializing SFTTrainer...")
    trainer = SFTTrainer(
